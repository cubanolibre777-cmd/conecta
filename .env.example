# Copia este archivo como ".env" y rellena tus propios valores.

# Clave secreta de Flask (cualquier cadena larga y aleatoria)
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga

# Credenciales de Google OAuth (ver instrucciones en README.md)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# Claves de Stripe en modo de prueba (ver instrucciones en README.md)
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta
STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publicable
